	$(COPY_FILE) --parents displays/MGR_QT.cpp main.cpp displays/MGR_NCURSES.cpp MGR_Terminal.cpp MGR_Terminal_Keyboard.cpp MGR_Terminal_Time.cpp MGR_Terminal_Render.cpp MGR_Terminal_Update.cpp modules/IMonitorModule.cpp modules/Module_CPU.cpp modules/Module_DISK.cpp modules/Module_HOST.cpp modules/Module_MemRegions.cpp modules/Module_Network.cpp modules/Module_OS.cpp modules/Module_PONY.cpp modules/Module_PROC.cpp modules/Module_RAM.cpp modules/Module_TIME.cpp modules/Module_VM.cpp modules/Module_CAT.cpp MGR_Module.cpp MGR_Module_Update.cpp displays/IMonitorDisplay.cpp widgets/barspainter.cpp widgets/cpuwidget.cpp widgets/graphmulticolorpainter.cpp widgets/graphpainter.cpp widgets/painterutils.cpp widgets/performancepainter.cpp widgets/performancewidget.cpp widgets/ramwidget.cpp widgets/dataquery.cpp widgets/memoryquery.cpp widgets/cpuquery.cpp widgets/cpudataquery.cpp widgets/ramdataquery.cpp $(DISTDIR)/
